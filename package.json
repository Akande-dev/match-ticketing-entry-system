{
  "name": "match-ticketing-entry-system",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-mtses",
    "seed": "node functions/scripts/seed.js",
    "set-role": "node functions/scripts/set-role.js",
    "test": "npm --prefix functions test",
    "lint": "npm --prefix functions run lint",
    "format": "prettier --write .",
    "test:int": "firebase emulators:exec --only firestore --project demo-mtses \"npm --prefix functions run test:int\"",
    "web": "npm --prefix web run dev"
  },
  "devDependencies": {
    "firebase-tools": "^15.37.0",
    "prettier": "^3.10.1"
  }
}
